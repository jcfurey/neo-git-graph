{
  "name": "branchwise",
  "displayName": "Branchwise",
  "version": "0.9.7",
  "description": "%description%",
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "branch",
    "git",
    "git graph",
    "git history",
    "git log"
  ],
  "homepage": "https://github.com/jcfurey/neo-git-graph",
  "bugs": {
    "url": "https://github.com/jcfurey/neo-git-graph/issues"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "Michael Hutchison",
      "url": "https://github.com/mhutchie"
    },
    {
      "name": "Asis Pattisahusiwa",
      "url": "https://github.com/asispts"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jcfurey/neo-git-graph.git"
  },
  "publisher": "jcfurey",
  "main": "./out/extension.js",
  "scripts": {
    "typecheck": "tsc -p . && tsc -p src/webview && tsc -p tests && tsc -p tests/webview && tsc -p tests-ext --noEmit",
    "vscode:prepublish": "pnpm run clean && pnpm run package",
    "package": "pnpm run typecheck && pnpm run lint && node esbuild.js --production",
    "package:vsix": "node scripts/check-release.cjs && vsce package --no-dependencies",
    "check:release": "node scripts/check-release.cjs",
    "check:links": "node scripts/markdown-links.cjs",
    "test:release": "node --test scripts/check-release.test.cjs scripts/markdown-links.test.cjs",
    "test:package": "node scripts/test-package.cjs",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "clean:all": "node -e \"const fs=require('fs');for(const p of ['out','tests-ext/out','.vscode-test','test-results',...fs.readdirSync('.').filter(f=>f.endsWith('.vsix'))])fs.rmSync(p,{recursive:true,force:true})\"",
    "compile": "pnpm run clean && node esbuild.js",
    "test": "vitest run --project backend && vitest run --project extension && vitest run --project webview",
    "test:coverage": "vitest run --project webview --coverage",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:ui": "node esbuild.js --production && node scripts/benchmark-ui.cjs",
    "test:ext": "pnpm run compile && pnpm run compile-tests && vscode-test",
    "test:ui-harness": "node --test tests-ext/ui/diagnostics.unit.cjs && node esbuild.js --production && pnpm run compile-tests && node scripts/test-ui-harness.cjs",
    "compile-tests": "tsc -p tests-ext/tsconfig.json && tsc-alias -p tests-ext/tsconfig.json",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc -p . --watch",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint": "oxlint",
    "test:lint-rules": "node --test oxlint/webview-text.test.cjs",
    "lint:fix": "oxlint --fix",
    "l10n:export": "vscode-l10n-dev export --outDir ./l10n ./src && oxfmt ./l10n/bundle.l10n.json",
    "l10n:check": "pnpm run l10n:export && git diff --exit-code ./l10n/bundle.l10n.json && node scripts/check-l10n.js"
  },
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "@vscode/l10n": "^0.0.18",
    "preact": "^10.29.8",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "~24.13.3",
    "@types/vscode": "~1.125.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^30.0.1",
    "ovsx": "^1.1.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "category": "Branchwise",
        "command": "branchwise.view",
        "title": "%command.view%",
        "icon": {
          "light": "resources/webview-icon-light.svg",
          "dark": "resources/webview-icon-dark.svg"
        }
      },
      {
        "category": "Branchwise",
        "command": "branchwise.fileHistory",
        "title": "%command.fileHistory%"
      },
      {
        "category": "Branchwise",
        "command": "branchwise.showBranches",
        "title": "%command.showBranches%"
      },
      {
        "category": "Branchwise",
        "command": "branchwise.openDocumentation",
        "title": "%command.openDocumentation%"
      },
      {
        "category": "Branchwise",
        "command": "branchwise.openWalkthrough",
        "title": "%command.openWalkthrough%"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "branchwise.view",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "explorer/context": [
        {
          "command": "branchwise.fileHistory",
          "group": "git",
          "when": "!explorerResourceIsFolder && (resourceScheme == file || resourceScheme == vscode-remote)"
        }
      ],
      "editor/title/context": [
        {
          "command": "branchwise.fileHistory",
          "group": "git",
          "when": "!explorerResourceIsFolder && (resourceScheme == file || resourceScheme == vscode-remote)"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Branchwise",
      "properties": {
        "branchwise.autoCenterCommitDetailsView": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoCenterCommitDetailsView%"
        },
        "branchwise.dateFormat": {
          "type": "string",
          "enum": [
            "Date & Time",
            "Date Only",
            "Relative"
          ],
          "enumDescriptions": [
            "%config.dateFormat.dateTime%",
            "%config.dateFormat.dateOnly%",
            "%config.dateFormat.relative%"
          ],
          "default": "Date & Time",
          "description": "%config.dateFormat%"
        },
        "branchwise.dateType": {
          "type": "string",
          "enum": [
            "Author Date",
            "Commit Date"
          ],
          "enumDescriptions": [
            "%config.dateType.authorDate%",
            "%config.dateType.commitDate%"
          ],
          "default": "Author Date",
          "description": "%config.dateType%"
        },
        "branchwise.fetchAvatars": {
          "type": "boolean",
          "default": false,
          "description": "%config.fetchAvatars%",
          "deprecationMessage": "%config.fetchAvatars.deprecation%"
        },
        "branchwise.graphColours": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "%config.graphColours.item%",
            "pattern": "^\\s*(#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8}|rgb[a]?\\s*\\(\\d{1,3},\\s*\\d{1,3},\\s*\\d{1,3}\\))\\s*$"
          },
          "default": [
            "#0085d9",
            "#d9008f",
            "#00d90a",
            "#d98500",
            "#a300d9",
            "#ff0000",
            "#00d9cc",
            "#e138e8",
            "#85d900",
            "#dc5b23",
            "#6f24d6",
            "#ffcc00"
          ],
          "description": "%config.graphColours%"
        },
        "branchwise.graphStyle": {
          "type": "string",
          "enum": [
            "rounded",
            "angular"
          ],
          "enumDescriptions": [
            "%config.graphStyle.rounded%",
            "%config.graphStyle.angular%"
          ],
          "default": "rounded",
          "description": "%config.graphStyle%"
        },
        "branchwise.initialLoadCommits": {
          "type": "integer",
          "minimum": 1,
          "default": 300,
          "description": "%config.initialLoadCommits%"
        },
        "branchwise.loadMoreCommits": {
          "type": "integer",
          "minimum": 1,
          "default": 100,
          "description": "%config.loadMoreCommits%"
        },
        "branchwise.maxDepthOfRepoSearch": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "%config.maxDepthOfRepoSearch%"
        },
        "branchwise.showCurrentBranchByDefault": {
          "type": "boolean",
          "default": false,
          "description": "%config.showCurrentBranchByDefault%"
        },
        "branchwise.showUncommittedChanges": {
          "type": "boolean",
          "default": true,
          "description": "%config.showUncommittedChanges%"
        },
        "branchwise.tabIconColourTheme": {
          "type": "string",
          "enum": [
            "colour",
            "grey"
          ],
          "enumDescriptions": [
            "%config.tabIconColourTheme.colour%",
            "%config.tabIconColourTheme.grey%"
          ],
          "default": "colour",
          "description": "%config.tabIconColourTheme%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "openGraph",
            "title": "%walkthrough.openGraph.title%",
            "description": "%walkthrough.openGraph.description%",
            "media": {
              "markdown": "walkthroughs/open-graph.md"
            },
            "completionEvents": [
              "onCommand:branchwise.view"
            ]
          },
          {
            "id": "readGraph",
            "title": "%walkthrough.readGraph.title%",
            "description": "%walkthrough.readGraph.description%",
            "media": {
              "markdown": "walkthroughs/read-graph.md"
            }
          },
          {
            "id": "actOnCommit",
            "title": "%walkthrough.actOnCommit.title%",
            "description": "%walkthrough.actOnCommit.description%",
            "media": {
              "markdown": "walkthroughs/act-on-commit.md"
            }
          },
          {
            "id": "branchesPane",
            "title": "%walkthrough.branchesPane.title%",
            "description": "%walkthrough.branchesPane.description%",
            "media": {
              "markdown": "walkthroughs/branches-pane.md"
            },
            "completionEvents": [
              "onCommand:branchwise.showBranches"
            ]
          },
          {
            "id": "focusAndRemotes",
            "title": "%walkthrough.focusAndRemotes.title%",
            "description": "%walkthrough.focusAndRemotes.description%",
            "media": {
              "markdown": "walkthroughs/focus-and-remotes.md"
            }
          },
          {
            "id": "recover",
            "title": "%walkthrough.recover.title%",
            "description": "%walkthrough.recover.description%",
            "media": {
              "markdown": "walkthroughs/recover.md"
            },
            "completionEvents": [
              "onCommand:branchwise.openDocumentation"
            ]
          }
        ]
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "packageManager": "pnpm@11.15.1",
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces%"
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces%"
    }
  }
}
